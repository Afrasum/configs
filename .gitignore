# macOS files
.DS_Store
DS_Store

# Backup and swap files
*~
*.swp
*.swo
*.swn

# Vim swap and undo files
*.bak
*.undo

# Python cache
__pycache__/

# Ignore .git directories inside plugin folders if not using submodules
.tmux/plugins/**/.git/

# Neovim plugin directories (e.g., plugin managers)
nvim/.local/
nvim/undo/
nvim/session.vim

# Tmux Plugin Manager data
.tmux/plugins/tpm/

# Environment and secret files
.env
.env.*

# Log files
*.log

# Ignore any other cache directories
cache/
# Raycast: config.json holds local state; extensions/ is compiled output that
# Raycast regenerates on every install/update. Only raycast/scripts/ is ours.
raycast/config.json
raycast/extensions/

# Claude Code local (machine-specific) settings
**/.claude/settings.local.json
.tmux/plugins/
.tmux/.DS_Store
